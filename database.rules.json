{
  "rules": {
    ".read": true,

    "vibes": {
      ".write": "auth != null",
      ".read": true
    },

    "challenge": {
      ".write": "auth != null",
      ".read": true
    },

    "admins": {
      ".read": false,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    }
  }
}
